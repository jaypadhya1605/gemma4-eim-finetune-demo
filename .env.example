# Azure subscription / Foundry project context from ../MSFT Non Prod.txt
AZURE_TENANT_ID=<your-tenant-id>
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_REGION=eastus2
AZURE_AUTH_MODE=vscode

# Auth modes: vscode, device_code, interactive_browser, service_principal.
# If Conditional Access blocks user login from this workstation, use a managed
# device/dev box or set AZURE_AUTH_MODE=service_principal and fill these locally.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# AzureML workspace for jobs, assets, managed endpoints, and A100 compute.
AZUREML_WORKSPACE_NAME=<your-azureml-workspace>
AZUREML_COMPUTE_NAME=a100-cluster-1node

# Optional labels for Foundry navigation. These are Foundry resources, not the AzureML workspace.
AZURE_AI_FOUNDRY_HUB_NAME=<optional-foundry-hub-name>
AZURE_AI_FOUNDRY_PROJECT_NAME=<optional-foundry-project-name>

# Gemma model from the Microsoft Foundry / AzureML Hugging Face catalog.
# BASE_MODEL_SOURCE=azureml_catalog mounts the catalog asset and does not require HF_TOKEN.
BASE_MODEL_SOURCE=azureml_catalog
AZUREML_CATALOG_MODEL_ID=azureml://registries/azure-huggingface/models/google--gemma-4-e2b-it/versions/1
HF_MODEL_ID=google/gemma-4-e2b-it
HF_TOKEN=
HF_TOKEN_SECRET_NAME=HF-TOKEN

# One A100 endpoint serves both variants. Requests set use_adapter=false/true.
ENDPOINT_NAME=gemma4-eim-demo
DEPLOYMENT_NAME=blue

# Training hyperparameters for the low-cost LoRA pass.
LORA_RANK=16
LORA_ALPHA=32
LEARNING_RATE=2e-4
NUM_EPOCHS=3
PER_DEVICE_BATCH_SIZE=4
GRAD_ACCUM_STEPS=4